root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 120

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = 120

[*.{txt,gitignore,gitattributes}]
trim_trailing_whitespace = false

[*.{json,jsonc,js,ts,jsx,tsx,css,scss,html,py,xml,ini,conf,properties}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2

[*.lua]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
trim_trailing_whitespace = false
